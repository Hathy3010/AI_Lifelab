ll><mxCell id="error" value="Báo lỗi, giữ bản nháp; thử lại cùng mã yêu cầu" style="rounded=1;arcSize=25;whiteSpace=wrap;html=0;fillColor=#FFF0ED;strokeColor=#C67E70;fontColor=#17354A;fontSize=15;fontFamily=Arial;spacing=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry as="geometry" x="850" y="1958" width="280" height="90" /></mxCell><mxCell id="shown" value="Hiển thị nhận xét đã lưu trong hồ sơ phiên" style="rounded=1;arcSize=25;whiteSpace=wrap;html=0;fillColor=#F4FAFF;strokeColor=#6897BC;fontColor=#17354A;fontSize=15;fontFamily=Arial;spacing=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry as="geometry" x="440" y="2130" width="280" height="64" /></mxCell><mxCell id="more" value="Xem học sinh khác?" style="rhombus;whiteSpace=wrap;html=0;fillColor=#FFF7E6;strokeColor=#C49843;fontColor=#17354A;fontSize=15;fontFamily=Arial;spacing=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry as="geometry" x="440" y="2240" width="280" height="100" /></mxCell><mxCell id="finish" value="Kết thúc giám sát" style="ellipse;whiteSpace=wrap;html=0;fillColor=#E8F8F1;strokeColor=#4C9477;fontColor=#17354A;fontSize=15;fontFamily=Arial;spacing=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry as="geometry" x="440" y="2430" width="280" height="64" /></mxCell><mxCell id="scope" value="Người giám sát trong MVP là giáo viên phụ trách lớp; chưa thêm vai trò quản trị riêng." style="rounded=1;arcSize=25;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#B2BCC8;fontColor=#17354A;fontSize=15;fontFamily=Arial;spacing=12;strokeWidth=1.5;dashed=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="850" y="290" width="280" height="110" /></mxCell><mxCell id="limits" value="Chỉ theo dõi tiến trình đã gửi về máy chủ; không xem camera, video hay màn hình trực tiếp của học sinh." style="rounded=1;arcSize=25;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#B2BCC8;fontColor=#17354A;fontSize=15;fontFamily=Arial;spacing=12;strokeWidth=1.5;dashed=1;" vertex="1" parent="1"><mxGeometry