<mxfile host="app.diagrams.net" type="device"><diagram id="04-erd-class" name="ERD A · Tài khoản, lớp và nhiệm vụ"><mxGraphModel grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1200" pageHeight="1420" connect="1" arrows="1"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="ERD A · Tài khoản, lớp và nhiệm vụ" style="text;html=0;fontSize=25;fontStyle=1;align=left;fontColor=#17354A;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="30" width="1120" height="60" /></mxCell><mxCell id="users" value="users&#10;PK id · username UNIQUE&#10;role · grade · school_code&#10;student_code · tên hiển thị" style="rounded=1;arcSize=15;whiteSpace=wrap;html=0;fontSize=15;fontFamily=Arial;spacing=12;fillColor=#E8F8F1;strokeColor=#679982;fontColor=#17354A;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry as="geometry" x="70" y="150" width="420" height="170" /></mxCell><mxCell id="classes" value="classes&#10;PK id&#10;FK teacher_id → users&#10;name · grade" style="rounded=1;arcSize=15;whiteSpace=wrap;html=0;fontSize=15;fontFamily=Arial;spacing=12;fillColor=#E8F8F1;strokeColor=#679982;fontColor=#17354A;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry as="geometry" x="710" y="150" width="420" height="170" /></mxCell><mxCell id="enroll" value="enrollments&#10;PK / FK class_id + student_id&#10;active · enrolled_at" style="rounded=1;arcSize=15;whiteSpace=wrap;html=0;fontSize=15;fontFamily=Arial;spacing=12;fillColor=#E8F8F1;strokeColor=#679982;fontColor=#17354A;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry as="geometry" x="710" y="490" width="420" height="150" /></mxCell><mxCell id="assign" value="assignments&#10;PK id · FK class_id + teacher_id&#10;scenario_id · config_version/hash&#10;due_at · request_id" style="rounded=1;arcSize=15;whiteSpace=wrap;html=0;fontSize=15;fontFamily=Arial;spacing=12;fillColor=#E8F8F1;strokeColor=#679982;fontColor=#17354A;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry as="geometry" x="70" y="490" width="420" height="170" /></mxCell><mxCell id="recipients" value="assignment_recipients&#10;PK assignment_id + student_id&#10;FK assignment + enrollment&#10;Snapshot danh sách lúc giao" style="rounded=1;arcSize=15;whiteSpace=wrap;html=0;fontSize=15;fontFamily=Arial;spacing=12;fillColor=#E8F8F1;strokeColor=#679982;fontColor=#17354A;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry as="geometry" x="70" y="850" width="420" height="170" /></mxCell><mxCell id="sessions" value="sessions (chi tiết trang ERD B)&#10;PK id · FK student_id&#10;FK assignment + student nếu có&#10;status · draft · revision" style="rounded=1;arcSize=15;whiteSpace=wrap;html=0;fontSize=15;fontFamily=Arial;spacing=12;fillColor=#E8F8F1;strokeColor=#679982;fontColor=#17354A;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry as="geometry" x="710" y="850" width="420" height="170" /></mxCell><mxCell id="note" value="Đọc: 1:0..N = một có thể có nhiều. Mỗi phiên gắn nhiệm vụ có đúng một người nhận; người nhận có thể chưa có phiên. Phiên tự học không cần assignment. Vai trò và quyền do backend kiểm tra." style="rounded=1;arcSize=15;whiteSpace=wrap;html=0;fontSize=15;fontFamily=Arial;spacing=12;fillColor=#FFFFFF;strokeColor=#ADBCC7;fontColor=#17354A;strokeWidth=1.5;dashed=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="70" y="1170" width="1060" height="120" /></mxCell><mxCell id="e0" value="1:0..N · giáo viên" source="users" target="classes" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#607B8E;fontColor=#17354A;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e1" value="1:0..N · thành viên" source="classes" target="enroll" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#607B8E;fontColor=#17354A;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"><mxGeometry 