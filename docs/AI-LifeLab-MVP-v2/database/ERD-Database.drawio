;entryY=0.5;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e7" value="1:0..N · chủ phiên" source="users" target="sessions" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#607B8E;fontColor=#17354A;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;entryX=0.5;entryY=1;"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="30" y="235" /><mxPoint x="30" y="1090" /><mxPoint x="920" y="1090" /></Array></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="05-erd-learning" name="ERD B · Phiên trải nghiệm và bằng chứng"><mxGraphModel grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1200" pageHeight="1780" connect="1" arrows="1"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="ERD B · Phiên trải nghiệm và bằng chứng" style="text;html=0;fontSize=25;fontStyle=1;align=left;fontColor=#17354A;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="30" width="1120" height="60" /></mxCell><mxCell id="session" value="sessions&#10;PK id · FK student / assignment&#10;scenario/version · draft/revision&#10;status · event_applied" style="rounded=1;arcSize=15;whiteSpace=wrap;html=0;fontSize=15;fontFamily=Arial;spacing=12;fillColor=#E8F8F1;strokeColor=#679982;fontColor=#17354A;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry as="geometry" x="430" y="150" width="340" height="170" /></mxCell><mxCell id="prediction" value="predictions&#10;PK id · FK session_id&#10;placements · revision/hash&#10;outcome · explanation" style="rounded=1;arcSize=15;whiteSpace=wrap;html=0;fontSize=15;fontFamily=Arial;spacing=12;fillColor=#E8F8F1;strokeColor=#679982;fontColor=#17354A;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="500" width="340" height="170" /></mxCell><mxCell id="attempt" value="attempts&#10;PK id · FK session_id&#10;FK prediction_id UNIQUE (nullable)&#10;input · result · source · request_id" style="rounded=1;arcSize=15;whiteSpace=wrap;html=0;fontSize=15;fontFamily=Arial;spacing=12;fillColor=#E8F8F1;strokeColor=#679982;fontColor=#17354A;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry as="geometry" x="430" y="500" width="340" height="170" /></mxCell><mxCell id="coach" value="coach_turns&#10;PK id · FK session_id&#10;question / answer · context_snapshot&#10;PENDING / READY · fallback&#10;Nguồn: xem ERD C" style="rounded=1;arcSize=15;whiteSpace=wrap;html=0;fontSize=15;fontFamily=Arial;spacing=12;fillColor=#E8F8F1;strokeColor=#679982;fontColor=#17354A;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry as="geometry" x="820" y="500" width="340" height="170" /></mxCell><mxCell id="reflection" value="reflections&#10;PK id · FK session_id UNIQUE&#10;FK selected_attempt_id&#10;Phản tư cuối bất biến" style="rounded=1;arcSize=15;whiteSpace=wrap;html=0;fontSize=15;fontFamily=Arial;spacing=12;fillColor=#E8F8F1;strokeColor=#679982;fontColor=#17354A;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry as="geometry" x="430" y="900" width="340" height="170" /></mxCell><mxCell id="evidence" value="evidence&#10;PK id · FK session_id&#10;FK attempt / comparison / reflection&#10;criterion_id · quan sát / AI đề xuất" style="rounded=1;arcSize=15;whiteSpace=wrap;html=0;fontSize=15;fontFamily=Arial;spacing=12;fillColor=#E8F8F1;strokeColor=#679982;fontColor=#17354A;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="1260" width="340" height="170" /></mxCell><mxCell id="review" value="teacher_reviews&#10;PK id · FK session_id&#10;FK teacher_id → users&#10;comment · assessments · request_id" style="rounded=1;arcSize=15;whiteSpace=wrap;html=0;fontSize=15;fontFamily=Arial;spacing=12;fillColor=#E8F8F1;strokeColor=#679982;fontColor=#17354A;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry as="geometry" x="820" y="1260" width="340" height="170" /></mxCell><mxCell id="note" value="Mỗi phiên có 0..N dự đoán, lượt thử, lượt Coach và nhận xét; 0..1 phản tư cuối. Bài 8.2 bắt buộc prediction; một prediction dùng tối đa một attempt. FK bằng chứng phải cùng phiên. Nguồn Coach dùng bảng nối coach_turn_sources, xem trang ERD C." style="rounded=1;arcSize=15;whiteSpace=wrap;html=0;fontSize=15;fontFamily=Arial;spacing=12;fillColor=#FFFFFF;strokeColor=#ADBCC7;fontColor=#17354A;strokeWidth=1.5;dashed=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="1540" width="1120" height="150" /></mxCell><mxCell id="e0" value="1:0..N" source="session" target="prediction" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#607B8E;fontColor=#17354A;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;entryX=0.5;entryY=0;"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="210" y="235" /></Array></mxGeometry></mxCell><mxCell id="e1" value="1:0..N" source="session" target="attempt" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#607B8E;fontColor=#17354A;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e2" value="1:0..N" source="session" target="coach" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#607B8E;fontColor=#17354A;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0.5;entryY=0;"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="990" y="235" /></Array></mxGeometry></mxCell><mxCell id="e3" value="1:0..1" source="prediction" target="attempt" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#607B8E;fontColor=#17354A;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e4" value="Lượt được chọn: 1:0..1" source="attempt" target="reflection" edge="1" parent="1" style="