mxCell></root></mxGraphModel></diagram><diagram id="09-erd-coach" name="ERD C · Chat Coach và nguồn tham chiếu"><mxGraphModel grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1200" pageHeight="1470" connect="1" arrows="1"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="ERD C · Chat Coach và nguồn tham chiếu" style="text;html=0;fontSize=25;fontStyle=1;align=left;fontColor=#17354A;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="30" width="1120" height="60" /></mxCell><mxCell id="sessions" value="sessions&#10;PK id&#10;Chủ phiên và cấu hình bài&#10;Chi tiết ở trang ERD B" style="rounded=1;arcSize=15;whiteSpace=wrap;html=0;fontSize=15;fontFamily=Arial;spacing=12;fillColor=#E8F8F1;strokeColor=#679982;fontColor=#17354A;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="160" width="300" height="220" /></mxCell><mxCell id="turns" value="coach_turns&#10;PK id · FK session_id&#10;question / answer · mode&#10;context_snapshot / hash&#10;PENDING → READY · generation&#10;prompt / model · fallback" style="rounded=1;arcSize=15;whiteSpace=wrap;html=0;fontSize=15;fontFamily=Arial;spacing=12;fillColor=#E8F8F1;strokeColor=#679982;fontColor=#17354A;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry as="geometry" x="430" y="160" width="340" height="220" /></mxCell><mxCell id="sources" value="coach_turn_sources&#10;PK coach_turn_id + attempt_id&#10;FK coach_turn_id + session_id&#10;FK attempt_id + session_id&#10;source_order: 1–4, không trùng" style="rounded=1;arcSize=15;whiteSpace=wrap;html=0;fontSize=15;fontFamily=Arial;spacing=12;fillColor=#E8F8F1;strokeColor=#679982;fontColor=#17354A;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry as="geometry" x="430" y="780" width="340" height="200" /></mxCell><mxCell id="attempts" value="attempts&#10;PK id · UNIQUE id + session_id&#10;input_json / result_json&#10;Chi tiết ở trang ERD B" style="rounded=1;arcSize=15;whiteSpace=wrap;html=0;fontSize=15;fontFamily=Arial;spacing=12;fillColor=#E8F8F1;strokeColor=#679982;fontColor=#17354A;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry as="geometry" x="820" y="780" width="340" height="200" /></mxCell><mxCell id="lifecycle" value="Một câu hỏi dùng 0..4 lượt thử. Một lượt thử có thể được nhiều câu hỏi tham chiếu. FK ghép cùng session_id ngăn lấy nguồn của phiên khác. PREDICT trước chạy có thể chưa có nguồn attempts nhưng luôn có snapshot phương án." style="rounded=1;arcSize=15;whiteSpace=wrap;html=0;fontSize=15;fontFamily=Arial;spacing=12;fillColor=#FFFFFF;strokeColor=#ADBCC7;fontColor=#17354A;strokeWidth=1.5;dashed=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="1110" width="1120" height="130" /></mxCell><mxCell id="transaction" value="Giao dịch ngắn: tạo PENDING + nguồn → COMMIT → gọi LLM → kiểm đầu ra → cập nhật READY nếu generation còn khớp. Lỗi model vẫn lưu READY với fallback=true. Không giữ khóa SQL trong lúc chờ LLM." style="rounded=1;arcSize=15;whiteSpace=wrap;html=0;fontSize=15;fontFamily=Arial;spacing=12;fillColor=#FFFFFF;strokeColor=#ADBCC7;fontColor=#17354A;strokeWidth=1.5;dashed=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="1280" width="1120" height="130" /></mxCell><mxCell id="e0" value="1:0..N" source="sessions" target="turns" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#607B8E;fontColor=#17354A;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e1" value="1:0..4" source="turns" target="sources" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#607B8E;fontColor=#17354A;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e2" value="1:0..N" source="attempts" target="sources" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#607B8E;fontColor=#17354A;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;entryX=1;entryY=0.5;"><mxGeometry as="geometry" relative="1" /></mxCell></root></mxGraphModel></diagram></mxfile>