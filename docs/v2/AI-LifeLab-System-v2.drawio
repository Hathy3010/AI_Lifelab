" relative="1" /></mxCell><mxCell id="e19" value="" source="complete" target="finish" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#607B8E;fontColor=#17354A;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"><mxGeometry as="geometry" relative="1" /></mxCell></root></mxGraphModel></diagram><diagram id="02-teacher" name="Teacher flow · Giao bài và giám sát"><mxGraphModel grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1200" pageHeight="2100" connect="1" arrows="1"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Teacher flow · Giao bài và giám sát" style="text;html=0;fontSize=25;fontStyle=1;align=left;fontColor=#17354A;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="30" width="1120" height="60" /></mxCell><mxCell id="start" value="Bắt đầu" style="ellipse;whiteSpace=wrap;html=0;fontSize=15;fontFamily=Arial;spacing=12;fillColor=#E8F8F1;strokeColor=#679982;fontColor=#17354A;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry as="geometry" x="440" y="130" width="280" height="70" /></mxCell><mxCell id="login" value="Đăng nhập → Chọn lớp phụ trách" style="rounded=1;arcSize=15;whiteSpace=wrap;html=0;fontSize=15;fontFamily=Arial;spacing=12;fillColor=#F4FAFF;strokeColor=#7399B7;fontColor=#17354A;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry as="geometry" x="440" y="260" width="280" height="70" /></mxCell><mxCell id="select" value="Chọn kịch bản → Xem trước" style="rounded=1;arcSize=15;whiteSpace=wrap;html=0;fontSize=15;fontFamily=Arial;spacing=12;fillColor=#F4FAFF;strokeColor=#7399B7;fontColor=#17354A;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry as="geometry" x="440" y="390" width="280" height="70" /></mxCell><mxCell id="setup" value="Đặt mục tiêu, hướng dẫn và thời hạn" style="rounded=1;arcSize=15;whiteSpace=wrap;html=0;fontSize=15;fontFamily=Arial;spacing=12;fillColor=#F4FAFF;strokeColor=#7399B7;fontColor=#17354A;stroke