dth=1.5;" vertex="1" parent="1"><mxGeometry as="geometry" x="440" y="1090" width="280" height="80" /></mxCell><mxCell id="result" value="Xem kết quả → Lưu dự đoán và lượt thử" style="rounded=1;arcSize=15;whiteSpace=wrap;html=0;fontSize=15;fontFamily=Arial;spacing=12;fillColor=#F4FAFF;strokeColor=#7399B7;fontColor=#17354A;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry as="geometry" x="440" y="1230" width="280" height="80" /></mxCell><mxCell id="ask" value="Muốn hỏi Coach?" style="rhombus;whiteSpace=wrap;html=0;fontSize=15;fontFamily=Arial;spacing=12;fillColor=#FFF7E6;strokeColor=#B89958;fontColor=#17354A;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry as="geometry" x="440" y="1370" width="280" height="100" /></mxCell><mxCell id="context" value="Chọn nguồn → Chốt ngữ cảnh theo revision" style="rounded=1;arcSize=15;whiteSpace=wrap;html=0;fontSize=15;fontFamily=Arial;spacing=12;fillColor=#F4FAFF;strokeColor=#7399B7;fontColor=#17354A;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry as="geometry" x="440" y="1560" width="280" height="80" /></mxCell><mxCell id="reply" value="Gọi LLM → Kiểm JSON / nguồn / action" style="rounded=1;arcSize=15;whiteSpace=wrap;html=0;fontSize=15;fontFamily=Arial;spacing=12;fillColor=#F4FAFF;strokeColor=#7399B7;fontColor=#17354A;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry as="geometry" x="440" y="1700" width="280" height="80" /></mxCell><mxCell id="show" value="Lưu hỏi–đáp → Hiển thị / tô sáng vật" style="rounded=1;arcSize=15;whiteSpace=wrap;html=0;fontSize=15;fontFamily=Arial;spacing=12;fillColor=#F4FAFF;strokeColor=#7399B7;fontColor=#17354A;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry as="geometry" x="440" y="1840" width="280" height="80" /></mxCell><mxCell id="next" value="Thử lại hoặc viết phản tư để hoàn thành" style="ellipse;whiteSpace=wrap;html=0;fontSize=15;fontFamily=Arial;spacing=12;fillColor=#E8F8F1;strokeColor=#679982;fontColor=#17354A;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry as="geometry" x="440" y="2040" width="280" height="80" /></mxCell><mxCell id="cancel" value="Mất tay / thả sai: hủy phần đang kéo, trả vật về vị trí đã chốt" style="rounded=1;arcSize=15;whiteSpace=wrap;html=0;fontSize=15;fontFamily=Arial;spacing=12;fillColor=#F4FAFF;strokeColor=#7399B7;fontColor=#17354A;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="560" width="280" height="110" /></mxCell><mxCell id="local" value="Trên thiết bị: video, landmarks, con trỏ và vật đang giữ. Không gửi từng khung hình." style="rounded=1;arcSize=15;whiteSpace=wrap;html=0;fontSize=15;fontFamily=Arial;spacing=12;fillColor=#FFFFFF;strokeColor=#ADBCC7;fontColor=#17354A;strokeWidth=1.5;dashed=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="810" y="340" width="310" height="130" /></mxCell><mxCell id="savedraft" value="sessions: lưu draft + revision khi online; chỉ báo Đã lưu sau xác nhận" style="rounded=1;arcSize=15;whiteSpace=wrap;html=0;fontSize=15;fontFamily=Arial;spacing=12;fillColor=#E8F8F1;strokeColor=#679982;fontColor=#17354A;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry as="geometry" x="810" y="760" width="310" height="100" /></mxCell><mxCell id="aierror" value="Timeout / sai đầu ra: dùng gợi ý có sẵn; đánh dấu fallback" style="rounded=1;arcSize=15;whiteSpace=wrap;html=0;fontSize=15;fontFamily=Arial;spacing=12;fillColor=#FFFFFF;strokeColor=#ADBCC7;fontColor=#17354A;strokeWidth=1.5;dashed=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="1700" width="280" height="110" /></mxCell><mxCell id="scope" value="Hỏi trước khi chạy cũng được: dùng phương án đã chốt, chưa có kết quả thì không tự tạo kết quả." style="rounded=1;arcSize=15;whiteSpace=wrap;html=0;fontSize=15;fontFamily=Arial;spacing=12;fillColor=#FFFFFF;strokeColor=#ADBCC7;fontColor=#17354A;strokeWidth=1.5;dashed=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="810" y="1510" width="310" height="130" /></mxCell><mxCell id="memory" value="Bản thử nghiệm hiện tại lưu tạm. Các bảng trong tài liệu là đích thiết kế, chưa phải database đã triển khai." style="rounded=1;arcSize=15;whiteSpace=wrap;html=0;fontSize=15;fontFamily=Arial;spacing=12;fillColor=#FFFFFF;strokeColor=#ADBCC7;fontColor=#17354A;strokeWidth=1.5;dashed=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="900" width="280" height="140" /></mxCell><mxCell id="e0" value="" source="start" target="camera" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#607B8E;fontColor=#17354A;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e1" value="" source="camera" target="gesture" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#607B8E;fontColor=#17354A;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e2" value="" source="gesture" target="valid" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#607B8E;fontColor=#17354A;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e3" value="Không" source="valid" target="cancel" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#607B8E;fontColor=#17354A;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;entryX=1;entryY=0.5;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e4" value="" source="cancel" target="gesture" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#607B8E;fontColor=#17354A;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;entryX=0;entryY=0.5;"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="200" y="450" /></Array></mxGeometry></mxCell><mxCell id="e5" value="Có" source="valid" target="draft" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#607B8E;fontColor=#17354A;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e6" value="Lưu nháp" source="draft" target="savedraft" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#607B8E;fontColor=#17354A;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e7" value="" source="draft" target="predict" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#607B8E;fontColor=#17354A;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e8" value="" source="predict" target="run" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#607B8E;fontColor=#17354A;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e9" value="" source="run" target="result" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#607B8E;fontColor=#17354A;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e10" value="" source="result" target="ask" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#607B8E;fontColor=#17354A;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e11" value="Có" source="ask" target="context" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#607B8E;fontColor=#17354A;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e12" value="Không" source="ask" target="next" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#607B8E;fontColor=#17354A;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=1;entryY=0.5;"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="1170" y="1420" /><mxPoint x="1170" y="2080" /></Array></mxGeometry></mxCell><mxCell id="e13" value="" source="context" target="reply" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#607B8E;fontColor=#17354A;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e14" value="" source="reply" target="show" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#607B8E;fontColor=#17354A;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e15" value="" source="show" target="next" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#607B8E;fontColor=#17354A;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"><mxGeometry as="geometry" relative="1" /></mxCell></root></mxGraphModel></diagram><diagram id="09-erd-coach" name="ERD C · Chat Coach và nguồn tham chiếu"><mxGraphModel grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1200" pageHeight="1470" connect="1" arrows="1"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="ERD C · Chat Coach và nguồn tham chiếu" style="text;html=0;fontSize=25;fontStyle=1;align=left;fontColor=#17354A;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="30" width="1120" height="60" /></mxCell><mxCell id="sessions" value="sessions&#10;PK id&#10;Chủ phiên và cấu hình bài&#10;Chi tiết ở trang ERD B" style="rounded=1;arcSize=15;whiteSpace=wrap;html=0;fontSize=15;fontFamily=Arial;spacing=12;fillColor=#E8F8F1;strokeColor=#679982;fontColor=#17354A;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="160" width="300" height="220" /></mxCell><mxCell id="turns" value="coach_turns&#10;PK id · FK session_id&#10;question / answer · mode&#10;context_snapshot / hash&#10;PENDING → READY · generation&#10;prompt / model · fallback" style="rounded=1;arcSize=15;whiteSpace=wrap;html=0;fontSize=15;fontFamily=Arial;spacing=12;fillColor=#E8F8F1;strokeColor=#679982;fontColor=#17354A;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry as="geometry" x="430" y="160" width="340" height="220" /></mxCell><mxCell id="sources" value="coach_turn_sources&#10;PK coach_turn_id + attempt_id&#10;FK coach_turn_id + session_id&#10;FK attempt_id + session_id&#10;source_order: 1–4, không trùng" style="rounded=1;arcSize=15;whiteSpace=wrap;html=0;fontSize=15;fontFamily=Arial;spacing=12;fillColor=#E8F8F1;strokeColor=#679982;fontColor=#17354A;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry as="geometry" x="430" y="780" width="340" height="200" /></mxCell><mxCell id="attempts" value="attempts&#10;PK id · UNIQUE id + session_id&#10;input_json / result_json&#10;Chi tiết ở trang ERD B" style="rounded=1;arcSize=15;whiteSpace=wrap;html=0;fontSize=15;fontFamily=Arial;spacing=12;fillColor=#E8F8F1;strokeColor=#679982;fontColor=#17354A;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry as="geometry" x="820" y="780" width="340" height="200" /></mxCell><mxCell id="lifecycle" value="Một câu hỏi dùng 0..4 lượt thử. Một lượt thử có thể được nhiều câu hỏi tham chiếu. FK ghép cùng session_id ngăn lấy nguồn của phiên khác. PREDICT trước chạy có thể chưa có nguồn attempts nhưng luôn có snapshot phương án." style="rounded=1;arcSize=15;whiteSpace=wrap;html=0;fontSize=15;fontFamily=Arial;spacing=12;fillColor=#FFFFFF;strokeColor=#ADBCC7;fontColor=#17354A;strokeWidth=1.5;dashed=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="1110" width="1120" height="130" /></mxCell><mxCell id="transaction" value="Giao dịch ngắn: tạo PENDING + nguồn → COMMIT → gọi LLM → kiểm đầu ra → cập nhật READY nếu generation còn khớp. Lỗi model vẫn lưu READY với fallback=true. Không giữ khóa SQL trong lúc chờ LLM." style="rounded=1;arcSize=15;whiteSpace=wrap;html=0;fontSize=15;fontFamily=Arial;spacing=12;fillColor=#FFFFFF;strokeColor=#ADBCC7;fontColor=#17354A;strokeWidth=1.5;dashed=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="1280" width="1120" height="130" /></mxCell><mxCell id="e0" value="1:0..N" source="sessions" target="turns" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#607B8E;fontColor=#17354A;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e1" value="1:0..4" source="turns" target="sources" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#607B8E;fontColor=#17354A;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e2" value="1:0..N" source="attempts" target="sources" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#607B8E;fontColor=#17354A;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;entryX=1;entryY=0.5;"><mxGeometry as="geometry" relative="1" /></mxCell></root></mxGraphModel></diagram></mxfile>