try" x="440" y="1460" width="280" height="70" /></mxCell><mxCell id="save" value="Lưu nhận xét riêng của giáo viên" style="rounded=1;arcSize=15;whiteSpace=wrap;html=0;fontSize=15;fontFamily=Arial;spacing=12;fillColor=#F4FAFF;strokeColor=#7399B7;fontColor=#17354A;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry as="geometry" x="440" y="1590" width="280" height="70" /></mxCell><mxCell id="more" value="Tiếp tục theo dõi?" style="rhombus;whiteSpace=wrap;html=0;fontSize=15;fontFamily=Arial;spacing=12;fillColor=#FFF7E6;strokeColor=#B89958;fontColor=#17354A;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry as="geometry" x="440" y="1730" width="280" height="100" /></mxCell><mxCell id="finish" value="Kết thúc" style="ellipse;whiteSpace=wrap;html=0;fontSize=15;fontFamily=Arial;spacing=12;fillColor=#E8F8F1;strokeColor=#679982;fontColor=#17354A;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry as="geometry" x="440" y="1940" width="280" height="70" /></mxCell><mxCell id="empty" value="Chưa bắt đầu: chưa kết luận về năng lực" style="rounded=1;arcSize=15;whiteSpace=wrap;html=0;fontSize=15;fontFamily=Arial;spacing=12;fillColor=#F4FAFF;strokeColor=#7399B7;fontColor=#17354A;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry as="geometry" x="800" y="1130" width="300" height="90" /></mxCell><mxCell id="identity" value="Một học sinh một tài khoản từ danh sách đã kiểm tra. Đổi lớp / đặt lại mật khẩu giữ nguyên tài khoản." style="rounded=1;arcSize=15;whiteSpace=wrap;html=0;fontSize=15;fontFamily=Arial;spacing=12;fillColor=#FFFFFF;strokeColor=#ADBCC7;fontColor=#17354A;strokeWidth=1.5;dashed=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="70" y="360" width="280" height="130" /></mxCell><mxCell id="errors" value="Không có quyền: không mở dữ liệu. Lỗi giao / lưu: báo chưa thành công, cho thử lại chống trùng." style="rounded=1;arcSize=15;whiteSpace=wrap;html=0;fontSize=15;fontFamily=Arial;spacing=12;fillColor=#FFFFFF;strokeColor=#ADBCC7;fontColor=#17354A;strokeWidth=1.5;dashed=1