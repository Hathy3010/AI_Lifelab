  "semantic_checks": [
    "Every referenced ID exists in this session",
    "Only three distinct allowed criteria",
    "Reflection ID matches final reflection",
    "SUPPORTED must cite a source; EV-03 needs two distinct input snapshots plus relevant explanation",
    "Output is a proposal, not a validated competence score"
  ]
}
