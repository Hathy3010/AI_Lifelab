{
  "components": {
    "schemas": {
      "Assessment": {
        "type": "object",
        "properties": {
          "criterion_id": {
            "type": "string",
            "enum": [
              "EV-01",
              "EV-02",
              "EV-03"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "INSUFFICIENT",
              "CLARIFY",
              "SUPPORTED",
              "NOT_APPLICABLE"
            ]
          },
          "comment": {
            "type": "string",
            "minLength": 1,
            "maxLength": 800,
            "pattern": "\\S"
          },
          "related_attempt_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "uniqueItems": true,
            "maxItems": 2
          },
          "reflection_id": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "criterion_id",
          "status",
          "comment",
          "related_attempt_ids",
          "reflection_id"
        ],
        "additionalProperties": false
      }
    }
  },
  "coach_response_schema": {
    "type": "object",
    "properties": {
      "origin": {
        "type": "string",
        "enum": [
          "AI",
          "FALLBACK"
        ]
      },
      "question": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500,
        "pattern": "\\S"
      },
      "hint": {
        "type": "string",
        "maxLength": 800
      },
      "related_attempt_ids": {
        "type": "array",
        "items": {
          "type": "string",
          "format": "uuid"
        },
        "uniqueItems": true,
        "maxItems": 2
      }
    },
    "required": [
      "origin",
      "question",
      "hint",
      "related_attempt_ids"
    ],
    "additionalProperties": false
  },
  "reflection_feedback_schema": {
    "type": "object",
    "properties": {
      "origin": {
        "type": "string",
        "enum": [
          "AI",
          "FALLBACK"
        ]
      },
      "prompt_version": {
        "const": "v1"
      },
      "assessments": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/Assessment"
        },
        "minItems": 3,
        "maxItems": 3
      },
      "requires_teacher_review": {
        "const": true
      }
    },
    "required": [
      "origin",
      "prompt_version",
      "assessments",
      "requires_teacher_review"
    ],
    "additionalProperties": false
  },
  "assessment_schema": {
    "type": "object",
    "properties": {
      "criterion_id": {
        "type": "string",
        "enum": [
          "EV-01",
          "EV-02",
          "EV-03"
        ]
      },
      "status": {
        "type": "string",
        "enum": [
          "INSUFFICIENT",
          "CLARIFY",
          "SUPPORTED",
          "NOT_APPLICABLE"
        ]
      },
      "comment": {
        "type": "string",
        "minLength": 1,
        "maxLength": 800,
        "pattern": "\\S"
      },
      "related_attempt_ids": {
        "type": "array",
        "items": {
          "type": "string",
          "format": "uuid"
        },
        "uniqueItems": true,
        "maxItems": 2
      },
      "reflection_id": {
        "type": "string",
        "format": "uuid"
      }
    },
    "required": [
      "criterion_id",
      "status",
      "comment",
      "related_attempt_ids",
      "reflection_id"
    ],
    "additionalProperties": false
  },
  "criteria": [
    "EV-01",
    "EV-02",
    "EV-03"
  ],
  "deadline_seconds": 10,
  "prompt_version": "v1",
  "fallback_by_scenario": {
    "8.1": [
